<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\APConfigManager.Infrastructure\APConfigManager.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ReactProjectPath>$(MSBuildThisFileDirectory)..\APConfigManager.UI\</ReactProjectPath>
    <ReactDistPath>$(ReactProjectPath)dist\</ReactDistPath>
  </PropertyGroup>

  <Target Name="BuildReactApp" BeforeTargets="Build" Condition="'$(Configuration)' != 'Debug' And Exists('$(ReactProjectPath)package.json')">
    <Exec WorkingDirectory="$(ReactProjectPath)" Command="npm ci" Condition="!Exists('$(ReactProjectPath)node_modules')" />
    <Exec WorkingDirectory="$(ReactProjectPath)" Command="npm run build" />
  </Target>

    <Target Name="CopyReactToWwwroot" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug' And Exists('$(ReactDistPath)')">
    <ItemGroup>
      <ReactFiles Include="$(ReactDistPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactFiles)"
          DestinationFiles="@(ReactFiles->'$(OutDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish drops build output into a separate publish dir; the wwwroot
       copied above lives only under bin, so copy the SPA into the publish output
       too. Forward slashes keep this correct on Linux (packaging host). -->
  <Target Name="CopyReactToPublish" AfterTargets="Publish" Condition="Exists('$(ReactDistPath)')">
    <ItemGroup>
      <ReactPublishFiles Include="$(ReactDistPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactPublishFiles)"
          DestinationFiles="@(ReactPublishFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
