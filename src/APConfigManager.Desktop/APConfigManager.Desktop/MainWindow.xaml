<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="APConfigManager.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AP Configuration Manager">

    <Grid>
        <WebView2 x:Name="WebView" />

        <Grid x:Name="LoadingOverlay" Background="#1a1a2e">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    Width="48"
                    Height="48"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="Loading AP Configuration Manager..." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
